rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ==================== HELPER FUNCTIONS ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // For now, assuming admin if they have a specific email domain or custom claim
      // This should be adjusted based on your actual admin logic
      return request.auth.token.admin == true || request.auth.token.email.endsWith('@bookup.admin');
    }

    function isSmallFile() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB
    }

    function isMediumFile() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB
    }

    function isLargeFile() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB
    }

    // ==================== USER PROFILE PICTURES ====================
    match /userProfiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId) && isSmallFile();
      allow delete: if isAdmin();
    }

    match /profile_pictures/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (fileName.startsWith(request.auth.uid) || fileName.contains(request.auth.uid)) && isSmallFile();
      allow delete: if isAdmin() || fileName.contains(request.auth.uid);
    }

    // ==================== STUDY MATERIALS ====================
    match /materials/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLargeFile();
      allow delete: if isAdmin();
    }

    // ==================== MATERIAL THUMBNAILS ====================
    match /thumbnails/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSmallFile();
      allow delete: if isAdmin();
    }

    // ==================== CHAT MEDIA - MODERN PATHS (Updated for depth) ====================
    // Path structure: chat_media/{type}/{conversationId}/{userId}/{messageId}.{ext}
    
    match /chat_media/images/{conversationId}/{userId}/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSmallFile();
      allow delete: if isAdmin() || isOwner(userId);
    }
    
    match /chat_media/images/{conversationId}/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSmallFile();
      allow delete: if isAdmin();
    }

    match /chat_media/videos/{conversationId}/{userId}/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLargeFile();
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /chat_media/videos/{conversationId}/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLargeFile();
      allow delete: if isAdmin();
    }

    match /chat_media/audio/{conversationId}/{userId}/{audioId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isMediumFile();
      allow delete: if isAdmin() || isOwner(userId);
    }
    
    match /chat_media/audio/{conversationId}/{audioId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isMediumFile();
      allow delete: if isAdmin();
    }

    match /chat_media/documents/{conversationId}/{userId}/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLargeFile();
      allow delete: if isAdmin() || isOwner(userId);
    }
    
    match /chat_media/documents/{conversationId}/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isLargeFile();
      allow delete: if isAdmin();
    }

    // ==================== LEGACY CHAT PATHS ====================
    match /chat/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isMediumFile();
      allow delete: if isAdmin();
    }

    // ==================== NEWS IMAGES ====================
    match /news/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    match /news_images/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    // ==================== TUTOR PROFILE IMAGES ====================
    match /tutors/{tutorId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(tutorId) || isAdmin()) && isSmallFile();
      allow delete: if isAdmin();
    }

    // ==================== TEMPORARY FILES ====================
    match /temp/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
      allow delete: if isAdmin();
    }

    // ==================== DEFAULT DENY ALL ====================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
