rules_version = '2';

// Cloud Storage Security Rules for BookUp
// Comprehensive rules covering all file types used in the application

service firebase.storage {
  match /b/{bucket}/o {
    
    // ==================== HELPER FUNCTIONS ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isSmallFile() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB
    }

    function isMediumFile() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB
    }

    function isLargeFile() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB
    }

    // ==================== USER PROFILE PICTURES ====================
    match /userProfiles/{userId}/{allPaths=**} {
      // Any authenticated user can read profile pictures
      allow read: if isSignedIn();
      
      // Users can upload/update their own profile pictures (max 10MB)
      allow write: if isSignedIn() && 
                      isOwner(userId) && 
                      isSmallFile();
      
      // Only admins can delete other users' profile pictures
      allow delete: if isAdmin();
    }

    // ==================== STUDY MATERIALS ====================
    match /materials/{materialId}/{fileName} {
      // Any authenticated user can read materials
      allow read: if isSignedIn();
      
      // Authenticated users can upload materials (max 100MB)
      allow create: if isSignedIn() && isLargeFile();
      
      // Only admins can delete materials
      allow delete: if isAdmin();
    }

    // ==================== CHAT MEDIA - MODERN PATHS ====================
    // Images, audio, video, and documents shared in chat conversations
    // Path structure: chat_media/{type}/{conversationId}/{messageId}.{ext}
    
    // IMAGES: chat_media/images/{conversationId}/{messageId}.jpg
    match /chat_media/images/{conversationId}/{imageId} {
      // Any authenticated user can read images
      allow read: if isSignedIn();
      
      // Authenticated users can upload images (max 10MB)
      allow create: if isSignedIn() && isSmallFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // VIDEOS: chat_media/videos/{conversationId}/{messageId}.mp4
    match /chat_media/videos/{conversationId}/{videoId} {
      // Any authenticated user can read videos
      allow read: if isSignedIn();
      
      // Authenticated users can upload videos (max 100MB)
      allow create: if isSignedIn() && isLargeFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // AUDIO: chat_media/audio/{conversationId}/{messageId}.m4a
    match /chat_media/audio/{conversationId}/{audioId} {
      // Any authenticated user can read audio
      allow read: if isSignedIn();
      
      // Authenticated users can upload audio (max 50MB)
      allow create: if isSignedIn() && isMediumFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // DOCUMENTS: chat_media/documents/{conversationId}/{messageId}.{ext}
    match /chat_media/documents/{conversationId}/{docId} {
      // Any authenticated user can read documents
      allow read: if isSignedIn();
      
      // Authenticated users can upload documents (max 100MB)
      allow create: if isSignedIn() && isLargeFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ==================== LEGACY CHAT PATHS (for backward compatibility) ====================
    match /chat/{chatId}/{fileName} {
      // Any authenticated user can read chat media
      allow read: if isSignedIn();
      
      // Authenticated users can upload chat media (max 50MB)
      allow create: if isSignedIn() && isMediumFile();
      
      // Only admins can delete chat media
      allow delete: if isAdmin();
    }

    // ==================== CHAT IMAGES SPECIFIC (LEGACY) ====================
    match /chat/images/{chatId}/{userId}/{fileName} {
      // Any authenticated user can read
      allow read: if isSignedIn();
      
      // Users can upload their own images (max 10MB)
      allow create: if isSignedIn() && 
                       isOwner(userId) && 
                       isSmallFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ==================== CHAT AUDIO SPECIFIC (LEGACY) ====================
    match /chat/audio/{chatId}/{userId}/{fileName} {
      // Any authenticated user can read
      allow read: if isSignedIn();
      
      // Users can upload their own audio (max 50MB)
      allow create: if isSignedIn() && 
                       isOwner(userId) && 
                       isMediumFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ==================== CHAT VIDEO SPECIFIC (LEGACY) ====================
    match /chat/video/{chatId}/{userId}/{fileName} {
      // Any authenticated user can read
      allow read: if isSignedIn();
      
      // Users can upload their own video (max 100MB)
      allow create: if isSignedIn() && 
                       isOwner(userId) && 
                       isLargeFile();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ==================== NEWS IMAGES ====================
    match /news/{newsId}/{fileName} {
      // Any authenticated user can read news images
      allow read: if isSignedIn();
      
      // Only admins can upload/delete news images
      allow create, delete: if isAdmin();
    }

    // ==================== TUTOR PROFILE IMAGES ====================
    match /tutors/{tutorId}/{fileName} {
      // Any authenticated user can read tutor images
      allow read: if isSignedIn();
      
      // Tutors can upload their own images; admins can upload for anyone (max 10MB)
      allow create: if isSignedIn() && 
                       (isOwner(tutorId) || isAdmin()) && 
                       isSmallFile();
      
      // Only admins can delete tutor images
      allow delete: if isAdmin();
    }

    // ==================== TEMPORARY FILES ====================
    // For uploads in progress, caching, etc.
    match /temp/{userId}/{allPaths=**} {
      // Users can read/write their own temp files
      allow read, write: if isSignedIn() && isOwner(userId);
      
      // Admins can manage all temp files
      allow delete: if isAdmin();
    }

    // ==================== DEFAULT DENY ALL ====================
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}

