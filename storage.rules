rules_version = '2';

// Cloud Storage rules for BookUp
// Allows authenticated users to upload media to their chat channels
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read/write to their chat media
    match /chats/{chatChannelId}/{allPaths=**} {
      // Allow any authenticated user to read chat media (messages are shared)
      allow read: if request.auth != null;
      
      // Allow write only for media uploads during chat
      // In production, you would verify the user is a participant in the channel
      allow write: if request.auth != null && 
        request.resource.size < 50 * 1024 * 1024; // Max 50MB per file
    }

    // User profile pictures
    match /userProfiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024; // Max 10MB for profile pics
    }

    // Study materials
    match /materials/{materialId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 100 * 1024 * 1024; // Max 100MB for materials
    }

    // Default deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
