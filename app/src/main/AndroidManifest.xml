<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application 
        android:name=".BookUpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_book_black_24dp"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_book_black_24dp"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookUp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowClearUserData="true"
        android:requestLegacyExternalStorage="false"
        android:preserveLegacyExternalStorage="false">
        <!-- Main/Launcher Activity -->
        <activity
            android:name=".activities.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".activities.SignInActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.SignUpActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ProfileSetupActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />

        <!-- Main App Activities -->
        <activity
            android:name=".activities.HomePageActivity"
            android:exported="true" />
        <activity
            android:name=".activities.SubjectSelectionActivity"
            android:exported="true" />

        <!-- Profile Management -->
        <activity
            android:name=".activities.ProfileEditActivity"
            android:exported="true" />
        <activity
            android:name=".activities.ChangePasswordActivity"
            android:exported="true" />
        <activity
            android:name=".activities.DeleteAccountActivity"
            android:exported="true" />

        <!-- Study Materials -->
        <activity
            android:name=".activities.UploadMaterialActivity"
            android:exported="true" />
        <activity
            android:name=".activities.MaterialDetailsActivity"
            android:exported="true" />
        <activity
            android:name=".activities.TutorDetailsActivity"
            android:exported="true" />
        <activity
            android:name=".activities.StudentDetailsActivity"
            android:exported="true" />
        <activity
            android:name=".activities.BookingSessionActivity"
            android:exported="true" />
        <activity
            android:name=".activities.TutorBookingsActivity"
            android:exported="true" />

        <!-- Chat & Communication -->
        <activity
            android:name=".activities.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ChatActivity"
            android:exported="true" />
        <activity
            android:name=".activities.CallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.CreateRequestActivity"
            android:exported="true" />
        <activity
            android:name=".activities.RequestDetailsActivity"
            android:exported="true" />
        <activity
            android:name=".activities.OffersListActivity"
            android:exported="true" />

        <!-- Admin Panel & Management -->
        <activity
            android:name=".activities.AdminPanelActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ManageNewsActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ManageMaterialsActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ManageUsersActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.ManageRequestsActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />

        <!-- News & Content -->
        <activity
            android:name=".activities.CreateNewsItemActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.EditNewsItemActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.NewsDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />

        <!-- Analytics & Settings -->
        <activity
            android:name=".activities.AnalyticsActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />
        <activity
            android:name=".activities.AppSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.BookUp.NoActionBar" />

        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver android:name=".notifications.CallActionReceiver" android:exported="false" />

        <!-- FileProvider for Android 7+ file access -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
