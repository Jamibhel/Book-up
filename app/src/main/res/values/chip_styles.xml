<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Chip Style -->
    <style name="Widget.Material3.Chip.Assist" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodySmall</item>
        <item name="chipIconEnabled">false</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/md_theme_light_primary</item>
    </style>

    <!-- Warning Chip -->
    <style name="Widget.Material3.Chip.Assist.Warning">
        <item name="chipBackgroundColor">@color/warning</item>
        <item name="chipStrokeColor">@color/warning</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Success Chip -->
    <style name="Widget.Material3.Chip.Assist.Success">
        <item name="chipBackgroundColor">@color/success</item>
        <item name="chipStrokeColor">@color/success</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Error Chip -->
    <style name="Widget.Material3.Chip.Assist.Error">
        <item name="chipBackgroundColor">@color/error</item>
        <item name="chipStrokeColor">@color/error</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>