<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================================ -->
    <!-- BOOKUP DESIGN SYSTEM - MODERN & SOPHISTICATED THEME -->
    <!-- Color Philosophy: Balanced, Accessible, Professional -->
    <!-- ============================================================================ -->

    <!-- BASIC PALETTE -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- ============================================================================ -->
    <!-- PRIMARY COLORS - Modern Green (Primary Brand) -->
    <!-- ============================================================================ -->
    <!-- Sophisticated forest green - professional yet vibrant -->
    <color name="primary">#2E8B57</color>              <!-- Forest Green - Primary -->
    <color name="primary_dark">#1B5E3F</color>         <!-- Darker variant for depth -->
    <color name="primary_light">#52B788</color>        <!-- Lighter variant for accents -->
    <color name="primary_lighter">#95D5B2</color>      <!-- Very light for backgrounds -->
    <color name="primary_faded">#D8F3DC</color>        <!-- Extremely light for surfaces -->

    <!-- ============================================================================ -->
    <!-- SECONDARY COLORS - Emerald Accent (Modern & Energetic) -->
    <!-- Adds a vibrant touch to the professional forest green -->
    <!-- ============================================================================ -->
    <color name="secondary">#10B981</color>            <!-- Emerald - vibrancy -->
    <color name="secondary_dark">#059669</color>       <!-- Darker emerald -->
    <color name="secondary_light">#34D399</color>      <!-- Light emerald -->
    <color name="secondary_lighter">#A7F3D0</color>    <!-- Very light emerald -->
    <color name="secondary_faded">#ECFDF5</color>      <!-- Pale emerald -->

    <!-- ============================================================================ -->
    <!-- ACCENT COLORS - Warm Gold (Energy & Premium Feel) -->
    <!-- Used sparingly for highlights and CTAs -->
    <!-- ============================================================================ -->
    <color name="accent">#F59E0B</color>               <!-- Warm amber gold -->
    <color name="accent_dark">#D97706</color>          <!-- Darker gold for interaction -->
    <color name="accent_light">#FCD34D</color>         <!-- Light gold for highlights -->

    <!-- ============================================================================ -->
    <!-- STATUS/SEMANTIC COLORS - Functional -->
    <!-- ============================================================================ -->
    <color name="success">#10B981</color>              <!-- Success - matches green family -->
    <color name="success_light">#D1FAE5</color>
    <color name="warning">#F59E0B</color>              <!-- Warning - amber gold -->
    <color name="warning_light">#FEF3C7</color>
    <color name="error">#EF4444</color>                <!-- Error - red -->
    <color name="error_light">#FEE2E2</color>
    <color name="info">#3B82F6</color>                 <!-- Info - soft blue (use minimally) -->
    <color name="info_light">#DBEAFE</color>

    <!-- ============================================================================ -->
    <!-- NEUTRAL COLORS - Grayscale (Professional Backbone) -->
    <!-- ============================================================================ -->
    <!-- Text Colors -->
    <color name="text_primary">#1F2937</color>        <!-- Dark gray - primary text -->
    <color name="text_secondary">#6B7280</color>      <!-- Medium gray - secondary text -->
    <color name="text_disabled">#D1D5DB</color>       <!-- Light gray - disabled text -->
    <color name="text_on_primary">#FFFFFF</color>     <!-- White on primary buttons -->
    <color name="text_on_secondary">#FFFFFF</color>   <!-- White on secondary buttons -->

    <!-- Background Colors -->
    <color name="bg_primary">#FFFFFF</color>          <!-- Pure white - main background -->
    <color name="bg_secondary">#F9FAFB</color>        <!-- Almost white - subtle contrast -->
    <color name="bg_tertiary">#F3F4F6</color>         <!-- Light gray - section backgrounds -->
    <color name="bg_overlay">#000000</color>          <!-- For overlays (with transparency) -->

    <!-- Border & Divider Colors -->
    <color name="border_light">#E5E7EB</color>        <!-- Very light - subtle dividers -->
    <color name="border_medium">#D1D5DB</color>       <!-- Medium - component borders -->
    <color name="border_dark">#9CA3AF</color>         <!-- Dark - emphasis borders -->

    <!-- ============================================================================ -->
    <!-- MATERIAL DESIGN 3 - LIGHT THEME (Primary Mode) -->
    <!-- ============================================================================ -->

    <!-- Primary Colors -->
    <color name="md_theme_light_primary">#2E8B57</color>
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <color name="md_theme_light_primaryContainer">#D8F3DC</color>
    <color name="md_theme_light_onPrimaryContainer">#0F3D27</color>

    <!-- Secondary Colors -->
    <color name="md_theme_light_secondary">#10B981</color>
    <color name="md_theme_light_onSecondary">#FFFFFF</color>
    <color name="md_theme_light_secondaryContainer">#D1FAE5</color>
    <color name="md_theme_light_onSecondaryContainer">#064E3B</color>

    <!-- Tertiary Colors (Warm accent) -->
    <color name="md_theme_light_tertiary">#D97706</color>
    <color name="md_theme_light_onTertiary">#FFFFFF</color>
    <color name="md_theme_light_tertiaryContainer">#FCD34D</color>
    <color name="md_theme_light_onTertiaryContainer">#78350F</color>

    <!-- Error Colors -->
    <color name="md_theme_light_error">#EF4444</color>
    <color name="md_theme_light_onError">#FFFFFF</color>
    <color name="md_theme_light_errorContainer">#FEE2E2</color>
    <color name="md_theme_light_onErrorContainer">#7F1D1D</color>

    <!-- Background & Surface Colors - LIGHT MODE REFINED -->
    <color name="md_theme_light_background">#F0FDF4</color> <!-- Very pale mint background -->
    <color name="md_theme_light_onBackground">#064E3B</color> <!-- Deep green text -->
    <color name="md_theme_light_surface">#FFFFFF</color> <!-- Clean white cards -->
    <color name="md_theme_light_onSurface">#064E3B</color>
    <color name="md_theme_light_surfaceVariant">#E8F5E9</color>
    <color name="md_theme_light_onSurfaceVariant">#2E8B57</color>

    <!-- Outline & Structure -->
    <color name="md_theme_light_outline">#D1FAE5</color>
    <color name="md_theme_light_outlineVariant">#ECFDF5</color>
    <color name="md_theme_light_scrim">#000000</color>
    <color name="md_theme_light_inverseSurface">#064E3B</color>
    <color name="md_theme_light_inverseOnSurface">#F0FDF4</color>
    <color name="md_theme_light_inversePrimary">#52B788</color>

    <!-- ============================================================================ -->
    <!-- MATERIAL DESIGN 3 - DARK THEME (Emerald Black) -->
    <!-- ============================================================================ -->

    <!-- Primary Colors - Dark Theme -->
    <color name="md_theme_dark_primary">#52B788</color>
    <color name="md_theme_dark_onPrimary">#052E16</color>
    <color name="md_theme_dark_primaryContainer">#065F46</color>
    <color name="md_theme_dark_onPrimaryContainer">#D1FAE5</color>

    <!-- Secondary Colors - Dark Theme -->
    <color name="md_theme_dark_secondary">#10B981</color>
    <color name="md_theme_dark_onSecondary">#022C22</color>
    <color name="md_theme_dark_secondaryContainer">#064E3B</color>
    <color name="md_theme_dark_onSecondaryContainer">#D1FAE5</color>

    <!-- Tertiary Colors - Dark Theme -->
    <color name="md_theme_dark_tertiary">#FBBF24</color>
    <color name="md_theme_dark_onTertiary">#451A03</color>
    <color name="md_theme_dark_tertiaryContainer">#78350F</color>
    <color name="md_theme_dark_onTertiaryContainer">#FDE68A</color>

    <!-- Error Colors - Dark Theme -->
    <color name="md_theme_dark_error">#F87171</color>
    <color name="md_theme_dark_onError">#450A0A</color>
    <color name="md_theme_dark_errorContainer">#7F1D1D</color>
    <color name="md_theme_dark_onErrorContainer">#FECACA</color>

    <!-- Background & Surface - DARK MODE (EMERALD BLACK) -->
    <color name="md_theme_dark_background">#020617</color> <!-- Deep charcoal black -->
    <color name="md_theme_dark_onBackground">#D1FAE5</color>
    <color name="md_theme_dark_surface">#064E3B</color> <!-- Deep Emerald Surface -->
    <color name="md_theme_dark_onSurface">#FFFFFF</color>
    <color name="md_theme_dark_surfaceVariant">#065F46</color>
    <color name="md_theme_dark_onSurfaceVariant">#D1FAE5</color>

    <!-- Outline & Structure - Dark Theme -->
    <color name="md_theme_dark_outline">#065F46</color>
    <color name="md_theme_dark_outlineVariant">#064E3B</color>
    <color name="md_theme_dark_scrim">#000000</color>
    <color name="md_theme_dark_inverseSurface">#F0FDF4</color>
    <color name="md_theme_dark_inverseOnSurface">#064E3B</color>
    <color name="md_theme_dark_inversePrimary">#2E8B57</color>

    <!-- ============================================================================ -->
    <!-- COMPONENT-SPECIFIC COLORS (Optional Overrides) -->
    <!-- ============================================================================ -->

    <!-- AppBar / Toolbar -->
    <color name="appbar_background">@color/primary</color>
    <color name="appbar_text">@color/text_on_primary</color>

    <!-- Floating Action Button (FAB) -->
    <color name="fab_background">@color/secondary</color>
    <color name="fab_text">@color/white</color>

    <!-- Buttons -->
    <color name="button_primary">@color/primary</color>
    <color name="button_secondary">@color/secondary</color>
    <color name="button_accent">@color/accent</color>

    <!-- Cards & Surfaces -->
    <color name="card_background">@color/bg_primary</color>
    <color name="card_border">@color/border_light</color>

    <!-- Chat Messages -->
    <color name="message_user">#2E8B57</color>         <!-- User messages - green -->
    <color name="message_ai">#1B9A8B</color>           <!-- AI messages - teal -->
    <color name="message_user_bg">#E8F5E9</color>      <!-- Light green background -->
    <color name="message_ai_bg">#E0F2F1</color>        <!-- Light teal background -->

    <!-- Bottom Navigation -->
    <color name="bottom_nav_inactive">#9CA3AF</color>
    <color name="bottom_nav_active">@color/primary</color>

    <!-- Input Fields -->
    <color name="input_background">#F9FAFB</color>
    <color name="input_border">@color/border_medium</color>
    <color name="input_focus">@color/primary</color>

    <!-- Placeholder / Hint Text -->
    <color name="placeholder_text">#A7F3D0</color>

    <!-- ============================================================================ -->
    <!-- LEGACY ALIASES (for backward compatibility with existing layouts) -->
    <!-- ============================================================================ -->
    <color name="md_theme_background">@color/md_theme_light_background</color>
    <color name="green">#2E8B57</color>
    <color name="colorSageGreen">#1B9A8B</color>
    <color name="colorGreen">#2E8B57</color>
    <color name="colorNeonGreen">#2E8B57</color>
    <color name="colorEarth">#2E8B57</color>
    <color name="colorGrey">#6B7280</color>
    <color name="colorAccent">#2E8B57</color>
    <color name="colorAccentDark">#2E8B57</color>
    <color name="colorPrimary">#2E8B57</color>
    <color name="colorSecondary">#2E8B57</color>
    <color name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</color>
    <color name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</color>
    <color name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</color>
    <color name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</color>
    <color name="colorOnPrimary">@color/md_theme_light_onPrimary</color>
    <color name="colorOnSecondary">@color/md_theme_light_onSecondary</color>
    <color name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</color>
    <color name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</color>

</resources>
