<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      BOOKUP MASTER PALETTE - ZERO PURPLE POLICY
      Everything is forced into Deep Green Dark Mode.
    -->

    <!-- Core Deep Greens -->
    <color name="brand_green_deep">#020806</color>
    <color name="brand_green_surface">#051A0E</color>
    <color name="brand_green_variant">#08311B</color>
    <color name="brand_green_primary">#2E8B57</color>
    <color name="brand_green_dark">#1B5E3F</color>
    <color name="brand_green_vibrant">#10B981</color>

    <!-- Unified Text -->
    <color name="text_white">#FFFFFF</color>
    <color name="text_mint">#D1FAE5</color>
    <color name="text_dim">#94A3B8</color>

    <!-- System -->
    <color name="error_red">#EF4444</color>
    <color name="warning_gold">#F59E0B</color>
    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Legacy Compatibility Mappings -->
    <color name="colorPrimary">@color/brand_green_primary</color>
    <color name="colorPrimaryDark">@color/brand_green_dark</color>
    <color name="colorAccent">@color/brand_green_vibrant</color>
    <color name="primary">@color/brand_green_primary</color>
    <color name="primary_dark">@color/brand_green_dark</color>
    <color name="secondary">@color/brand_green_vibrant</color>
    <color name="green">@color/brand_green_primary</color>
    <color name="error">@color/error_red</color>

    <!-- MD3 Palette Mapping -->
    <color name="md_theme_primary">@color/brand_green_primary</color>
    <color name="md_theme_onPrimary">@color/white</color>
    <color name="md_theme_primaryContainer">@color/brand_green_dark</color>
    <color name="md_theme_onPrimaryContainer">@color/text_mint</color>

    <color name="md_theme_secondary">@color/brand_green_vibrant</color>
    <color name="md_theme_onSecondary">@color/white</color>
    <color name="md_theme_secondaryContainer">@color/brand_green_variant</color>
    <color name="md_theme_onSecondaryContainer">@color/text_mint</color>

    <color name="md_theme_background">@color/brand_green_deep</color>
    <color name="md_theme_onBackground">@color/text_mint</color>
    <color name="md_theme_surface">@color/brand_green_surface</color>
    <color name="md_theme_onSurface">@color/text_white</color>
    <color name="md_theme_surfaceVariant">@color/brand_green_variant</color>
    <color name="md_theme_onSurfaceVariant">@color/text_mint</color>
    <color name="md_theme_outline">@color/brand_green_dark</color>
    <color name="md_theme_outlineVariant">@color/brand_green_variant</color>

    <!-- Absolute Consistency: Mapping Light theme resources to Dark theme values -->
    <color name="md_theme_light_primary">@color/brand_green_primary</color>
    <color name="md_theme_light_onPrimary">@color/white</color>
    <color name="md_theme_light_primaryContainer">@color/brand_green_dark</color>
    <color name="md_theme_light_onPrimaryContainer">@color/text_mint</color>
    <color name="md_theme_light_background">@color/brand_green_deep</color>
    <color name="md_theme_light_onBackground">@color/text_mint</color>
    <color name="md_theme_light_surface">@color/brand_green_surface</color>
    <color name="md_theme_light_onSurface">@color/text_white</color>
    <color name="md_theme_light_surfaceVariant">@color/brand_green_variant</color>
    <color name="md_theme_light_onSurfaceVariant">@color/text_mint</color>
    <color name="md_theme_light_outline">@color/brand_green_dark</color>
    <color name="md_theme_light_tertiaryContainer">@color/brand_green_variant</color>
    <color name="md_theme_light_onTertiaryContainer">@color/text_mint</color>

</resources>
