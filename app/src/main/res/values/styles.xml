<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Text Styles for Book Up - Adapted for Material Design 3 -->
    <!-- (Using Poppins for headlines/titles/labels, Nunito for body, Open Sans for captions/small labels) -->

    <!-- DISPLAY (Large, impactful text) -->
    <style name="TextAppearance.BookUp.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="TextAppearance.BookUp.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- HEADLINE (Section titles) -->
    <style name="TextAppearance.BookUp.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- TITLE (Toolbar, card titles, etc.) -->
    <style name="TextAppearance.BookUp.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- BODY (Standard text) -->
    <style name="TextAppearance.BookUp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/nunito_font_family</item>
        <item name="android:fontFamily">@font/nunito_font_family</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="TextAppearance.BookUp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_font_family</item>
        <item name="android:fontFamily">@font/nunito_font_family</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="TextAppearance.BookUp.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/nunito_font_family</item>
        <item name="android:fontFamily">@font/nunito_font_family</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- LABEL (Buttons, captions, small functional text) -->
    <style name="TextAppearance.BookUp.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/poppins_font_family</item>
        <item name="android:fontFamily">@font/poppins_font_family</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/open_sans_font_family</item>
        <item name="android:fontFamily">@font/open_sans_font_family</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="TextAppearance.BookUp.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/open_sans_font_family</item>
        <item name="android:fontFamily">@font/open_sans_font_family</item>
        <item name="android:textStyle">normal</item>
    </style>
    <!-- In your styles.xml, within the <resources> tag -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- In your styles.xml, within the <resources> tag -->
    <style name="ShapeAppearanceOverlay.App.CornerSizeLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30%</item> <!-- This makes it a perfect circle -->
    </style>

    <!-- You should also have this for smaller rounded corners if you used it -->
    <style name="ShapeAppearanceOverlay.App.CornerSizeSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item> <!-- Or adjust to your preference -->
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize10Percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>

    <!-- Shape appearance for chat avatars and small components -->
    <style name="ShapeAppearance.BookUp.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- ============================================ -->
    <!-- COMPONENT STYLES (Material Design 3) -->
    <!-- Simplified for compatibility -->
    <!-- ============================================ -->

    <!-- CARD STYLES -->
    <style name="Widget.BookUp.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:padding">@dimen/card_padding</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <!-- TEXT INPUT STYLES -->
    <style name="Widget.BookUp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:paddingStart">@dimen/spacing_l</item>
        <item name="android:paddingEnd">@dimen/spacing_l</item>
        <item name="boxCornerRadiusTopStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_corner_radius</item>
    </style>

    <!-- CHIP STYLES -->
    <style name="Widget.BookUp.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:paddingStart">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chip_padding_horizontal</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
    </style>

    <!-- TOOLBAR STYLES -->
    <style name="Widget.BookUp.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="elevation">@dimen/elevation_nav</item>
    </style>

    <!-- FAB (Floating Action Button) STYLES -->
    <style name="Widget.BookUp.FAB" parent="Widget.Design.FloatingActionButton">
        <item name="android:layout_margin">@dimen/spacing_l</item>
        <item name="elevation">@dimen/elevation_fab</item>
    </style>

    <!-- AVATAR STYLES -->
    <style name="Widget.BookUp.Avatar" parent="">
        <item name="android:layout_width">@dimen/avatar_size_default</item>
        <item name="android:layout_height">@dimen/avatar_size_default</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.App.CornerSize50Percent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:contentDescription">@string/user_avatar</item>
    </style>

    <!-- MESSAGE BUBBLE STYLES -->
    <style name="Widget.BookUp.MessageBubbleOutgoing" parent="Widget.BookUp.Card">
        <item name="android:padding">@dimen/message_bubble_padding</item>
        <item name="cardCornerRadius">@dimen/message_bubble_corner_radius</item>
        <item name="cardBackgroundColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.BookUp.MessageBubbleIncoming" parent="Widget.BookUp.Card">
        <item name="android:padding">@dimen/message_bubble_padding</item>
        <item name="cardCornerRadius">@dimen/message_bubble_corner_radius</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <!-- ERROR STATE STYLES -->
    <style name="Widget.BookUp.ErrorContainer" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/padding_default</item>
        <item name="android:paddingEnd">@dimen/padding_default</item>
        <item name="android:paddingTop">@dimen/padding_large</item>
        <item name="android:paddingBottom">@dimen/padding_large</item>
        <item name="android:background">?attr/colorErrorContainer</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- EMPTY STATE STYLES -->
    <style name="Widget.BookUp.EmptyState" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/padding_default</item>
        <item name="android:paddingEnd">@dimen/padding_default</item>
        <item name="android:paddingTop">@dimen/padding_large</item>
        <item name="android:paddingBottom">@dimen/padding_large</item>
    </style>

    <!-- ============================================ -->
    <!-- TEXT APPEARANCE OVERRIDES -->
    <!-- ============================================ -->

    <!-- Large body text with better readability -->
    <style name="TextAppearance.BookUp.BodyLarge.Readable">
        <item name="android:lineSpacingExtra">@dimen/line_height_body</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Caption text for secondary information -->
    <style name="TextAppearance.BookUp.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/open_sans_font_family</item>
        <item name="android:fontFamily">@font/open_sans_font_family</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">italic</item>
    </style>

    <!-- Error text styling -->
    <style name="TextAppearance.BookUp.Error" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorError</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Helper text styling -->
    <style name="TextAppearance.BookUp.Helper" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ============================================ -->
    <!-- ACCESSIBILITY CONSIDERATIONS -->
    <!-- ============================================ -->

    <!-- High contrast text for visibility -->
    <style name="TextAppearance.BookUp.HighContrast" parent="TextAppearance.BookUp.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Large button for easier touch targets -->
    <style name="Widget.BookUp.Button.Large" parent="">
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:paddingStart">@dimen/padding_default</item>
        <item name="android:paddingEnd">@dimen/padding_default</item>
    </style>

    <!-- Progress Bar - Modern Material Design 3 -->
    <style name="Widget.BookUp.ProgressBar" parent="Widget.Material3.CircularProgressIndicator">
        <item name="android:indeterminate">true</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
    </style>

</resources>
