<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- THEME RESET: Forced Deep Green Dark Mode -->
    <style name="Theme.BookUp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Palette Mapping -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>

        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>

        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- System UI -->
        <item name="android:statusBarColor">@color/brand_green_deep</item>
        <item name="android:navigationBarColor">@color/brand_green_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Global Widget Overrides -->
        <item name="materialCardViewStyle">@style/Widget.BookUp.Card</item>
        <item name="materialButtonStyle">@style/Widget.BookUp.Button</item>
        <item name="textInputStyle">@style/Widget.BookUp.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.BookUp.BottomNav</item>
        <item name="toolbarStyle">@style/Widget.BookUp.Toolbar</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.BookUp.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.BookUp.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.BookUp.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.BookUp.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.BookUp.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.BookUp.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.BookUp.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.BookUp.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.BookUp.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.BookUp.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.BookUp.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.BookUp.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.BookUp.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.BookUp.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.BookUp.LabelSmall</item>
    </style>

    <style name="Theme.BookUp.NoActionBar" parent="Theme.BookUp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- UI COMPONENTS -->
    <style name="Widget.BookUp.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/brand_green_surface</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/brand_green_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BookUp.Medium</item>
    </style>

    <style name="Widget.BookUp.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/brand_green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BookUp.Small</item>
    </style>

    <style name="Widget.BookUp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_green_primary</item>
        <item name="hintTextColor">@color/brand_green_vibrant</item>
        <item name="startIconTint">@color/brand_green_primary</item>
        <item name="boxBackgroundColor">@color/brand_green_deep</item>
    </style>

    <style name="Widget.BookUp.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/brand_green_surface</item>
        <item name="itemIconTint">@color/bottom_nav_color_state</item>
        <item name="itemTextColor">@color/bottom_nav_color_state</item>
    </style>

    <style name="Widget.BookUp.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="backgroundTint">@color/brand_green_primary</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <!-- SHAPES -->
    <style name="ShapeAppearance.BookUp.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.BookUp.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.BookUp.SmallComponent" parent="ShapeAppearance.BookUp.Small" />

    <style name="ShapeAppearanceOverlay.App.CornerSizeSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CornerSizeLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30%</item>
    </style>

    <!-- TYPOGRAPHY -->
    <style name="TextAppearance.BookUp.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BookUp.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BookUp.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BookUp.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BookUp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_mint</item>
    </style>
    <style name="TextAppearance.BookUp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_mint</item>
    </style>
    <style name="TextAppearance.BookUp.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_mint</item>
    </style>

    <style name="TextAppearance.BookUp.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_mint</item>
    </style>
    <style name="TextAppearance.BookUp.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_mint</item>
    </style>
    <style name="TextAppearance.BookUp.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_mint</item>
    </style>

</resources>
