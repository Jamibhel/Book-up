<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cache directory for audio recordings, images, videos -->
    <cache-path
        name="cache"
        path="/" />
    
    <!-- External cache directory (accessible without READ_EXTERNAL_STORAGE on newer Android) -->
    <external-cache-path
        name="external_cache"
        path="/" />
    
    <!-- Files directory -->
    <files-path
        name="files"
        path="/" />
</paths>
