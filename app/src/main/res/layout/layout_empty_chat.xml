<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/layout_empty_chat"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/image_empty_chat"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/empty_chat_image_desc"
        android:src="@drawable/ic_empty_chat"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/text_empty_chat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/empty_chat_title"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:id="@+id/text_empty_chat_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/empty_chat_description"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>