<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="activities.SignInActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_default"
            android:gravity="center_horizontal">

            <!-- App Logo with Modern Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/icon_size_extra_large"
                android:layout_height="@dimen/icon_size_extra_large"
                android:layout_marginTop="@dimen/padding_large"
                android:layout_marginBottom="@dimen/padding_large"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                android:contentDescription="@string/app_logo">

                <ImageView
                    android:layout_width="86dp"
                    android:layout_height="68dp"
                    android:padding="@dimen/padding_default"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_book_black_24dp"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Welcome Headline -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/welcome_back"
                style="@style/TextAppearance.BookUp.HeadlineLarge"
                android:textColor="?attr/colorOnBackground"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_large"
                android:text="@string/sign_in_subtitle"
                style="@style/TextAppearance.BookUp.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <!-- Email Input with Modern Style -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/text_input_email"
                style="@style/Widget.BookUp.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_default"
                android:hint="@string/email_field"
                app:startIconDrawable="@drawable/ic_email_black_24dp"
                app:endIconMode="clear_text"
                app:helperText="@string/email_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:paddingStart="40dp"
                    android:id="@+id/edit_text_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/text_input_height"
                    android:inputType="textEmailAddress"
                    android:textSize="@dimen/text_size_body_medium"
                    android:contentDescription="@string/email_field" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input with Modern Style -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/text_input_password"
                style="@style/Widget.BookUp.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:hint="@string/password_field"
                app:startIconDrawable="@drawable/ic_lock_black_24dp"
                app:endIconMode="password_toggle"
                app:helperText="@string/password_requirements">

                <com.google.android.material.textfield.TextInputEditText
                    android:paddingStart="40dp"
                    android:id="@+id/edit_text_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/text_input_height"
                    android:inputType="textPassword"
                    android:textSize="@dimen/text_size_body_medium"
                    android:contentDescription="@string/password_field" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot Password Link -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_forgot_password"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/padding_large"
                android:text="@string/forgot_password"
                android:textSize="@dimen/text_size_label_medium"
                android:textColor="?attr/colorPrimary"
                android:contentDescription="@string/forgot_password_link" />

            <!-- Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_in"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginStart="@dimen/padding_default"
                android:layout_marginEnd="@dimen/padding_default"
                android:layout_marginBottom="@dimen/padding_large"
                android:text="@string/sign_in"
                android:textSize="@dimen/text_size_label_large"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary"
                android:contentDescription="@string/sign_in_button"
                android:elevation="@dimen/card_elevation" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/padding_default"
                android:layout_marginEnd="@dimen/padding_default"
                android:layout_marginBottom="@dimen/padding_large">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_default"
                    android:layout_marginEnd="@dimen/margin_default"
                    android:text="@string/divider_or"
                    style="@style/TextAppearance.BookUp.LabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- Google Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google_sign_in"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginStart="@dimen/padding_default"
                android:layout_marginEnd="@dimen/padding_default"
                android:layout_marginBottom="@dimen/padding_large"
                android:text="@string/sign_in_with_google"
                android:textSize="@dimen/text_size_label_large"
                android:textColor="?attr/colorOnSurface"
                android:contentDescription="@string/sign_in_with_google_button"
                app:icon="@drawable/ic_google_logo"
                app:iconTint="@null"
                app:strokeColor="?attr/colorOutline"
                android:background=""
                />

            <!-- Don't Have Account? Text & Sign Up Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_account_question"
                    style="@style/TextAppearance.BookUp.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sign_up_link"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="@string/sign_up"
                    android:textSize="@dimen/text_size_label_medium"
                    android:textColor="?attr/colorPrimary"
                    android:contentDescription="@string/sign_up_button" />
            </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Progress Bar (Overlay) -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.BookUp.ProgressBar"
            android:layout_width="@dimen/icon_size_extra_large"
            android:layout_height="@dimen/icon_size_extra_large"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:indeterminateTint="?attr/colorPrimary"
            android:elevation="@dimen/elevation_level_3" />

    </androidx.constraintlayout.widget.ConstraintLayout>
