rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isDocumentOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // ==================== CONVERSATIONS COLLECTION (Modern Chat) ====================
    // Supports new chat system: conversations/{conversationId}
    match /conversations/{conversationId} {
      
      // Can read own conversations (must be in participantIds)
      allow read: if isSignedIn() && 
                     request.auth.uid in resource.data.participantIds;
      
      // Can create conversation if you're in participantIds
      allow create: if isSignedIn() && 
                       request.auth.uid in request.resource.data.participantIds &&
                       request.resource.data.participantIds != null;
      
      // Can update own conversations
      allow update: if isSignedIn() && 
                       request.auth.uid in resource.data.participantIds;
      
      // Can delete own conversations
      allow delete: if isSignedIn() && 
                       request.auth.uid in resource.data.participantIds;

      // ==================== MESSAGES SUBCOLLECTION ====================
      match /messages/{messageId} {
        
        // Can read messages from conversations you're in
        allow read: if isSignedIn() && 
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Can send message if you're in conversation
        allow create: if isSignedIn() && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                         request.resource.data.senderId == request.auth.uid;
        
        // Only sender can update/delete
        allow update, delete: if isSignedIn() && 
                                  resource.data.senderId == request.auth.uid;
      }
    }

    // ==================== CHAT CHANNELS COLLECTION (Legacy Support) ====================
    // Support for legacy chatChannels with participantIds array
    match /chatChannels/{channelId} {
      // Allow read if user is a participant
      allow read: if isSignedIn() && 
                     request.auth.uid in resource.data.participantIds;
      
      // Create new channel if you're a participant
      allow create: if isSignedIn() && 
                       request.auth.uid in request.resource.data.participantIds;
      
      // Can update if participant
      allow update: if isSignedIn() && 
                       request.auth.uid in resource.data.participantIds;
      
      // Don't allow deleting channels
      allow delete: if false;

      // ==================== MESSAGES SUBCOLLECTION (Legacy) ====================
      match /messages/{messageId} {
        // Can read messages if participant in channel
        allow read: if isSignedIn() && 
                       get(/databases/$(database)/documents/chatChannels/$(channelId)).data.participantIds.hasAny([request.auth.uid]);
        
        // Can write if participant in channel
        allow write: if isSignedIn() && 
                        get(/databases/$(database)/documents/chatChannels/$(channelId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }

    // ==================== USERS COLLECTION ====================
    match /users/{userId} {
      // Any authenticated user can read any profile (for search/discovery/chat)
      allow read: if isSignedIn();
      
      // Users can only create their own profile
      allow create: if isSignedIn() && 
                       userId == request.auth.uid;
      
      // Users can only update their own profile (with restrictions)
      allow update: if isSignedIn() && 
                       userId == request.auth.uid &&
                       // Prevent users from setting themselves as admin
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) ||
                        request.resource.data.isAdmin == false);
      
      // Users cannot delete their profile
      allow delete: if false;
    }

    // ==================== STUDY MATERIALS (Legacy Collection) ====================
    match /studyMaterials/{materialId} {
      // All authenticated users can read
      allow read: if isSignedIn();
      
      // Only creator can create materials
      allow create: if isSignedIn() && 
                       request.resource.data.uploaderUid == request.auth.uid;
      
      // Only creator or admin can update/delete
      allow update, delete: if isSignedIn() && 
                               (resource.data.uploaderUid == request.auth.uid || isAdmin());
    }

    // ==================== MATERIALS COLLECTION (Current) ====================
    match /materials/{materialId} {
      // All authenticated users can read
      allow read: if isSignedIn();
      
      // Only creator can create materials
      allow create: if isSignedIn() && 
                       request.resource.data.uploadedBy == request.auth.uid;
      
      // Only creator or admin can update/delete
      allow update, delete: if isSignedIn() && 
                               (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // ==================== TUTORS COLLECTION ====================
    match /tutors/{tutorId} {
      // Any authenticated user can read tutor information (for discovery)
      allow read: if isSignedIn();
      
      // Tutor can create their own profile; admins can create for others
      allow create: if isSignedIn() && 
                       (tutorId == request.auth.uid || isAdmin());
      
      // Tutor can update their own profile; admins can update any
      allow update: if isSignedIn() && 
                       (tutorId == request.auth.uid || isAdmin());
      
      // Only admins can delete tutors
      allow delete: if isAdmin();
    }

    // ==================== NEWS FEED ====================
    match /newsFeed/{newsId} {
      // All authenticated users can read news
      allow read: if isSignedIn();
      
      // Only admins can create, update, delete news
      allow create, update, delete: if isAdmin();
    }

    // ==================== HELP REQUESTS ====================
    match /helpRequests/{requestId} {
      // All authenticated users can create requests
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      
      // All authenticated users can read requests
      allow read: if isSignedIn();
      
      // Only creator or admin can update requests
      allow update: if isSignedIn() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      
      // Only creator or admin can delete requests
      allow delete: if isSignedIn() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== APP SETTINGS ====================
    match /appSettings/{document=**} {
      // All authenticated users can read app settings
      allow read: if isSignedIn();
      
      // Only admins can create, update, delete settings
      allow create, update, delete: if isAdmin();
    }

    // ==================== AI CHAT MESSAGES ====================
    match /aiChat/{userId}/{messageId} {
      // Users can read only their own chat messages
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      // Users can create their own messages
      allow create: if isSignedIn() && 
                       userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own messages
      allow update, delete: if isSignedIn() && 
                               userId == request.auth.uid &&
                               resource.data.userId == request.auth.uid;
    }

    // ==================== NOTIFICATIONS ====================
    match /notifications/{userId}/{notificationId} {
      // Users can read only their own notifications
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      // System/admin can create notifications (or functions)
      allow create: if isSignedIn();
      
      // Users can update/delete their own notifications
      allow update, delete: if isSignedIn() && userId == request.auth.uid;
    }

    // ==================== USER ACTIVITY LOG ====================
    match /userActivity/{userId}/{activityId} {
      // Users can read only their own activity
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      // System can create activity logs
      allow create: if isSignedIn();
      
      // Users cannot modify their activity logs (immutable)
      allow update, delete: if false;
    }

    // ==================== DEFAULT DENY ALL ====================
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
